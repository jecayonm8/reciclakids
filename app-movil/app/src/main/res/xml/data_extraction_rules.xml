<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o posterior. Las sesiones van cifradas con una llave del Android Keystore que no
     sale del teléfono: restauradas en otro serían ilegibles, así que no se respaldan ni se copian. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesiones_cifradas.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesiones_cifradas.xml" />
    </device-transfer>
</data-extraction-rules>
